        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{base_url}}/auth/usuarios", "host": ["{{base_url}}"], "path": ["auth", "usuarios"] }
      }
    },
